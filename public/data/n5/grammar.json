    ],
    "order": 1,
    "tags": [
      "conjunction"
    ]
  },
  {
    "id": "grammar:n5-002",
    "pattern": "〜がいます / 〜があります",
    "meaningRu": "есть; находится",
    "explanationRu": "います употребляется с живыми существами, あります — с предметами и явлениями.",
    "examples": [
      {
        "textJa": "公園に猫がいます。",
        "translationRu": "В парке есть кошка."
      }
