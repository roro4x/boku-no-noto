[
  {
    "id": "grammar:n5-001",
    "pattern": "〜が",
    "meaningRu": "но; однако",
    "explanationRu": "Соединяет две части высказывания и вводит противопоставление.",
    "examples": [
      {
        "textJa": "この本は高いですが、面白いです。",
        "translationRu": "Эта книга дорогая, но интересная."
      }
